##############################
# Database
##############################

# Managed Postgres (Neon) — use the exact connection string Neon gives you,
# including any ?sslmode=require it appends. Takes priority over DB_* below
# (see database/engine.py). Recommended: a second database ("job_search")
# in the same Neon project already used by Investment-Tracker.
# DATABASE_URL=postgresql://user:password@host/job_search?sslmode=require

# Local/self-hosted Postgres fallback: fill these in only if DATABASE_URL is unset.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=job_search
DB_USER=postgres
DB_PASSWORD=password

##############################
# AI (Anthropic)
##############################

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Cheaper/faster tier used for high-volume job-match scoring specifically
# (analysis/job_matcher.py score_job); resume parsing/tailoring/prep stay on
# ANTHROPIC_MODEL above.
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

##############################
# Optional: Google Custom Search (off by default, capped free tier)
##############################

GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

##############################
# Application
##############################

ENV=development
DEBUG=True
LOG_LEVEL=INFO

# GitHub username whose public repos feed gap_advisor.py project recommendations
GITHUB_USERNAME=HarshithR7
